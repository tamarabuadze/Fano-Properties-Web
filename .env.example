# ─── Copy these variables into Railway's environment settings ───

# Supabase Database
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Admin Auth (NextAuth)
AUTH_SECRET=run: openssl rand -hex 32
ADMIN_EMAIL=admin@fanoproperties.com
ADMIN_PASSWORD_HASH=bcrypt_hash_of_your_password

# App
NEXTAUTH_URL=https://fanoproperties.com
NEXT_PUBLIC_SITE_URL=https://fanoproperties.com

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Property uploads: attach a Railway Volume (uploads turn on automatically), or use Supabase Storage
# with a public "property-media" bucket and this secret, server-only key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google tags (optional; read when a page is served, so a change on Railway needs no code change).
# Set any of them. They load on every page of the website and on the /lp landing pages.
GTM_ID=GTM-XXXXXXX            # Google Tag Manager container
GA_MEASUREMENT_ID=G-XXXXXXXXXX # Google Analytics 4
GOOGLE_ADS_ID=AW-XXXXXXXXXX    # Google Ads

# Where website enquiries are copied to (the Fano team app's Lead inbox). Leave unset for the default:
# app.fanoproperties.workers.dev, with fano-ai.fanoproperties.workers.dev as a backup only. Both run the
# same app on one database, so a lead goes to one of them, never both. To change the order or addresses:
# FANO_APP_LEAD_URLS=https://app.fanoproperties.workers.dev/api/lead,https://fano-ai.fanoproperties.workers.dev/api/lead
